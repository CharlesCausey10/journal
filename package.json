{
    "name": "journal",
    "version": "1.2.0-beta.1",
    "description": "A customizable daily journal",
    "license": "MIT",
    "author": {
        "name": "Charles Causey",
        "email": "charlescausey10@gmail.com"
    },
    "scripts": {
        "start": "node scripts/desktop.cjs dev --config src-tauri/dev.conf.json",
        "dev:web": "vite --config vite.config.mts",
        "build:web": "vite build --config vite.config.mts",
        "build": "node scripts/desktop.cjs build --no-bundle",
        "package": "node scripts/desktop.cjs build",
        "test": "jest",
        "test:native": "node scripts/desktop.cjs test",
        "postinstall": "npm --prefix .erb/tooling ci",
        "lint": "cross-env NODE_ENV=development eslint . --ext .js,.jsx,.ts,.tsx,.cjs",
        "test:smoke": "node scripts/smoke-windows.cjs"
    },
    "browserslist": [
        "extends browserslist-config-erb"
    ],
    "prettier": {
        "singleQuote": true,
        "overrides": [
            {
                "files": [
                    ".prettierrc",
                    ".eslintrc"
                ],
                "options": {
                    "parser": "json"
                }
            }
        ]
    },
    "dependencies": {
        "@fontsource/delius": "^5.3.0",
        "@fontsource/handlee": "^5.3.0",
        "@fontsource/patrick-hand": "^5.3.0",
        "@lexical/clipboard": "^0.52.0",
        "@lexical/code-core": "^0.52.0",
        "@lexical/extension": "^0.52.0",
        "@lexical/history": "^0.52.0",
        "@lexical/html": "^0.52.0",
        "@lexical/list": "^0.52.0",
        "@lexical/link": "^0.52.0",
        "@lexical/markdown": "^0.52.0",
        "@lexical/react": "^0.52.0",
        "@lexical/rich-text": "^0.52.0",
        "lexical": "^0.52.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^7.18.4"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "@swc/core": "^1.16.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/jest": "^30.0.0",
        "@types/node": "26.6.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/react-test-renderer": "^19.3.0",
        "@types/semver": "^7.8.0",
        "@vitejs/plugin-react": "^5.2.0",
        "browserslist-config-erb": "^0.0.3",
        "cross-env": "^10.1.0",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-compat": "^7.0.2",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.12.0",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^30.5.1",
        "jest-environment-jsdom": "^30.5.1",
        "prettier": "^3.9.6",
        "react-test-renderer": "^19.3.0",
        "sass": "^1.104.1",
        "svgo": "^4.1.0",
        "type-fest": "^5.9.0",
        "typescript": "^7.0.2",
        "vite": "^7.3.6",
        "vite-plugin-svgr": "^4.5.0",
        "@tauri-apps/cli": "2.12.4"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24.0.0",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=10.0.0",
            "onFail": "error"
        }
    },
    "overrides": {
        "eslint-plugin-react": {
            "eslint": "$eslint"
        },
        "eslint-plugin-import": {
            "eslint": "$eslint"
        },
        "eslint-plugin-jsx-a11y": {
            "eslint": "$eslint"
        }
    },
    "engines": {
        "node": ">=24.0.0",
        "npm": ">=10.0.0"
    },
    "type": "commonjs"
}
