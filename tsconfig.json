{
  "compilerOptions": {
    "incremental": true,
    "target": "es2022",
    "module": "nodenext",
    "lib": [
      "dom",
      "es2022"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "sourceMap": true,
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "outDir": ".erb/dll",
    "rootDir": ".",
    "types": [
      "node",
      "jest"
    ]
  },
  "exclude": [
    "test",
    "release/build",
    "release/app/dist",
    ".erb/dll",
    "node_modules",
    ".erb/tooling/node_modules"
  ],
  "include": [
    "src/renderer",
    "src/shared",
    "src/__tests__/App.test.tsx",
    "src/__tests__/journal-tabs.test.tsx",
    "src/__tests__/checklist-order.test.ts",
    "assets"
  ]
}
