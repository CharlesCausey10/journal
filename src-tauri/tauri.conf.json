{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Journal",
  "version": "1.2.0-beta.1",
  "identifier": "com.charlescausey.journal",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Journal",
        "width": 1000,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "maximized": true,
        "dragDropEnabled": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:1420 ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'none'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "appimage"
    ],
    "icon": [
      "../assets/icon.ico",
      "../assets/icon.png",
      "../assets/icon.icns"
    ],
    "shortDescription": "A customizable daily journal",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/CharlesCausey10/journal/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
